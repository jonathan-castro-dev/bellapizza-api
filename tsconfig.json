{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./build",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext"],
    "noEmit": true,
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
